# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase admin key. NEVER expose to browser/client code.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider is optional for local development. Defaults to mock.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# WhatsApp / Meta webhook secrets are optional until live integration is configured.
WHATSAPP_MODE=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Base64-encoded 32-byte key for AES-256-GCM server-side credential encryption.
WHATSAPP_ENCRYPTION_KEY=
